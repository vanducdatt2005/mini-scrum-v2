generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  password        String
  fullName        String?
  avatar          String?
  role            String          @default("MEMBER")
  createdAt       DateTime        @default(now())
  projects        ProjectMember[]
  assignedStories UserStory[]          @relation("AssignedStories")
  assignedTasks   Task[]               @relation("AssignedTasks")
  standups        DailyStandup[]
  comments        Comment[]
  attachments     Attachment[]
  notificationsReceived Notification[] @relation("ReceivedNotifications")
  notificationsSent     Notification[] @relation("SentNotifications")
  contributions   MemberContribution[] // Đóng góp trong các Sprint
  activityLogs    ActivityLog[]        @relation("ActorActivityLogs")
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  goal        String?
  inviteCode  String?         @unique
  createdAt   DateTime        @default(now())
  members     ProjectMember[]
  userStories UserStory[]
  sprints     Sprint[]
  standups    DailyStandup[]
  notifications Notification[]
  activityLogs  ActivityLog[]
}

model ProjectMember {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  role      String
  status    String  @default("ACCEPTED")
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, projectId])
}

model Sprint {
  id        String      @id @default(cuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    String      @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  projectId String
  project   Project        @relation(fields: [projectId], references: [id])
  stories   UserStory[]
  createdAt DateTime       @default(now())
  summary   SprintSummary? // Kết quả tổng kết Sprint
}

model UserStory {
  id           String  @id @default(cuid())
  title        String
  description  String?
  storyPoints  Int?
  status       String  @default("TODO")
  priority     String  @default("MEDIUM")
  tags         String  @default("[]")
  projectId    String
  assigneeId   String?
  sprintId     String?
  backlogOrder Int     @default(0)
  assignee     User?   @relation("AssignedStories", fields: [assigneeId], references: [id])
  project      Project @relation(fields: [projectId], references: [id])
  sprint       Sprint? @relation(fields: [sprintId], references: [id])
  hoursSpent   Int?        // Giờ thực tế hoàn thành (nullable, ước tính SP×4 nếu null)
  tasks        Task[]
  comments     Comment[]
  attachments  Attachment[]
  updatedAt    DateTime?   @updatedAt
  statusHistory UserStoryStatusHistory[]
  priorityOrder Int @default(0)
}

model UserStoryStatusHistory {
  id          String    @id @default(cuid())
  storyId     String
  userStory   UserStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  status      String
  changedAt   DateTime  @default(now())

  @@index([storyId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, DONE
  storyId     String
  userStory   UserStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  version     Int       @default(1)
  comments    Comment[]
  attachments Attachment[]
  notifications Notification[]

  @@index([id, version])
}

model DailyStandup {
  id        String   @id @default(cuid())
  yesterday String
  today     String
  blockers  String?
  date      DateTime @default(now())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, date])
}

model Comment {
  id               String      @id @default(cuid())
  content          String
  entityType       EntityType? @map("entity_type")
  entityId         String?     @map("entity_id")
  mentionedUserIds String[]    @default([]) @map("mentioned_user_ids")
  isEdited         Boolean     @default(false) @map("is_edited")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Hỗ trợ cả UserStory lẫn Task (giữ nguyên dữ liệu cũ)
  userStoryId      String?
  userStory        UserStory?  @relation(fields: [userStoryId], references: [id], onDelete: Cascade)

  taskId           String?
  task             Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId           String
  user             User        @relation(fields: [userId], references: [id])

  attachments      Attachment[]

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("comments")
}
model Attachment {
  id          String    @id @default(cuid())
  fileName    String
  fileUrl     String
  fileSize    Int
  fileType    String
  createdAt   DateTime  @default(now())

  // Liên kết với Task hoặc User Story tương tự như Comment
  userStoryId String?
  userStory   UserStory? @relation(fields: [userStoryId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  commentId   String?    @map("comment_id")
  comment     Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId      String
  user        User       @relation(fields: [userId], references: [id])

  @@index([commentId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   // recipient_id (người nhận thông báo)
  senderId    String?  // sender_id (người giao task)
  taskId      String?  // task_id
  projectId   String?  // project_id
  content     String
  type        String   @default("TASK_ASSIGNED") // TASK_ASSIGNED, SYSTEM, KICKED, TASK_CHANGED, v.v..
  taskTitle   String?
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  user        User     @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender      User?    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ============================================================
// MÔ-ĐUN TỔNG KẾT SPRINT (End Sprint & Contribution Assessment)
// ============================================================

/// Lưu kết quả tổng kết của một Sprint sau khi kết thúc.
/// Được tạo bởi PO/SM khi gọi API generate.
model SprintSummary {
  id             String               @id @default(cuid())
  sprintId       String               @unique
  sprint         Sprint               @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  totalSP        Int                  // Tổng Story Points đạt được (status=DONE)
  totalHours     Int                  // Tổng giờ làm việc thực tế (hoặc ước tính)
  plannedSP      Int                  // Tổng SP ban đầu của Sprint
  completionRate Float                // % hoàn thành = (doneStories / totalStories) × 100
  notes          String?              // Nhận xét / Retrospective của PO/SM
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  contributions  MemberContribution[]
}

/// Lưu đóng góp của từng thành viên trong một Sprint.
/// Được tính tự động khi generate SprintSummary.
model MemberContribution {
  id               String        @id @default(cuid())
  summaryId        String
  summary          SprintSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  roleInSprint     String        // Vai trò tại thời điểm kết thúc (PO/SM/DEV/TESTER/DESIGNER)
  storiesCompleted Int           // Số User Story hoàn thành (status=DONE)
  storyPoints      Int           // Tổng SP của stories được assign và DONE
  hoursWorked      Int           // Tổng giờ làm việc (thực tế hoặc ước tính)
  specialMetric    String?       @default("{}")
  contributionPct  Float         // % đóng góp cuối cùng (tổng = 100%)
  createdAt        DateTime      @default(now())

  @@unique([summaryId, userId]) // Mỗi thành viên chỉ có 1 entry / Sprint
}

// ============================================================
// MÔ-ĐUN AUDIT TRAIL / ACTIVITY LOGS (Immutable History)
// ============================================================

enum EntityType {
  TASK
  USER_STORY
}

enum ActionType {
  CREATED
  UPDATED_STATUS
  UPDATED_ASSIGNEE
  UPDATED_TITLE
  UPDATED_DESCRIPTION
  UPDATED_PRIORITY
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  COMMENT_ADDED
  COMMENT_UPDATED
  COMMENT_DELETED
}

model ActivityLog {
  id             String      @id @default(cuid())
  projectId      String?     @map("project_id")
  actorId        String?     @map("actor_id")
  action         String?     @map("action")
  targetType     String?     @map("target_type")
  targetId       String?     @map("target_id")
  targetTitle    String?     @map("target_title")
  meta           Json?       @map("meta")
  entityType     EntityType? @map("entity_type")
  entityId       String?     @map("entity_id")
  actionType     ActionType? @map("action_type")
  changesPayload Json?       @map("changes_payload")
  createdAt      DateTime    @default(now()) @map("created_at")

  actor          User?       @relation("ActorActivityLogs", fields: [actorId], references: [id], onDelete: SetNull)
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("activity_logs")
}
